# ============================================
# SUI NETWORK
# ============================================
SUI_NETWORK=localnet

# Custom RPC URL (optional, defaults based on network)
# SUI_RPC_URL=http://127.0.0.1:9000

# ============================================
# KEYS & ADDRESSES
# ============================================
ADMIN_ADDRESS=
SPONSOR_ADDRESSES=

ADMIN_PRIVATE_KEY=
PLAYER_A_PRIVATE_KEY=
PLAYER_B_PRIVATE_KEY=

# ============================================
# PACKAGE IDS (populated after deployment)
# ============================================
WORLD_PACKAGE_ID=
BUILDER_PACKAGE_ID=
EXTENSION_CONFIG_ID=

# ============================================
# TENANT
# ============================================
TENANT=dev

# ============================================
# NEW VARIABLES (appended)
# ============================================

# World object IDs (used by attestor / mock-killmail)
WORLD_OBJECT_REGISTRY_ID=

# ============================================
# ATTESTOR (local)
# ============================================
ATTESTOR_PRIVATE_KEY=
ATTESTOR_KEY_ID=local-dev-key-1
ATTESTOR_HOST=127.0.0.1
ATTESTOR_PORT=8787

# ============================================
# BOUNTY DEFAULTS (scripts)
# ============================================
BOUNTY_COIN_TYPE=0x2::sui::SUI
BOUNTY_TARGET_ADDRESS=
BOUNTY_ESCROW_AMOUNT=
BOUNTY_EXPIRES_AT_MS=0
