# ============================================
# BASE (shared across scripts + attestor)
# ============================================

# Pick network: localnet | testnet | devnet | mainnet
NETWORK=localnet

# Optional: override RPC URL (defaults by NETWORK)
# localnet: http://127.0.0.1:9000
# testnet:  https://fullnode.testnet.sui.io:443
# SUI_RPC_URL=

# World tenant (localnet defaults to dev; Utopia is utopia)
TENANT=dev

# IMPORTANT: WORLD_PACKAGE_ID must be the **original-id** from
# https://github.com/evefrontier/world-contracts/blob/main/contracts/world/Published.toml
# (do NOT use published-at)
WORLD_PACKAGE_ID=

# Required for killmail verification / character derivation
WORLD_OBJECT_REGISTRY_ID=

# ============================================
# BOUNTY EXTENSION (your published package)
# ============================================

BUILDER_PACKAGE_ID=
EXTENSION_CONFIG_ID=

# Optional but recommended: AdminCap object id from publish output
ADMIN_CAP_ID=

# Coin type used for escrow in scripts (dapp uses VITE_BOUNTY_COIN_TYPE)
BOUNTY_COIN_TYPE=0x2::sui::SUI

# ============================================
# KEYS (never commit real values)
# ============================================

# Used by TS scripts and configure-rules. Must be the key that OWNS AdminCap.
ADMIN_PRIVATE_KEY=

# Used by local scripts to simulate hunter accept/claim
PLAYER_A_PRIVATE_KEY=

# Used by attestor and configure-rules (to derive trusted_attestor)
ATTESTOR_PRIVATE_KEY=

# ============================================
# ATTESTOR SERVER (optional)
# ============================================

ATTESTOR_KEY_ID=local-dev-key-1
ATTESTOR_HOST=127.0.0.1
ATTESTOR_PORT=8787

# ============================================
# SCRIPT OVERRIDES (optional)
# ============================================

# create-bounty.ts
BOUNTY_TARGET_ADDRESS=
BOUNTY_ESCROW_AMOUNT=
BOUNTY_EXPIRES_AT_MS=0

# mock-killmail.ts (localnet only)
# KILLER_CHARACTER_ID=
# VICTIM_CHARACTER_ID=
# LOSS_TYPE=1
