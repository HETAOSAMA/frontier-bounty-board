# Frontend (Vite) env vars
# - Copy to `builder-scaffold/dapps/.env`
# - Restart `pnpm dev` after changes

# Sui GraphQL endpoint
VITE_SUI_GRAPHQL_ENDPOINT=https://graphql.testnet.sui.io/graphql

# World (use original-id from world-contracts Published.toml)
VITE_EVE_WORLD_PACKAGE_ID=

# Bounty extension (your published package)
VITE_BUILDER_PACKAGE_ID=
VITE_EXTENSION_CONFIG_ID=

# Escrow coin type
VITE_BOUNTY_COIN_TYPE=0x2::sui::SUI

# Attestor base URL
VITE_ATTESTOR_URL=http://127.0.0.1:8787

# Optional: set a specific bounty id for debug flows
# VITE_BOUNTY_ID=

# Legacy/template var (not used by bounty dApp)
# VITE_OBJECT_ID=
